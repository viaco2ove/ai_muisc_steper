# panel_app backend env template
# LLM 配置 (通过 models.json 管理，已在 models.json 配置好)
# LLM_API_KEY=xxx
# LLM_BASE_URL=http://127.0.0.1:3428/v1
# LLM_MODEL=deepseek-v4-pro

# 服务端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8120

# Python 解释器 (Windows 上用 miniconda3，有 fastapi)
# 注意：.venv 可能缺少 fastapi 依赖
PYTHON_EXE=D:/ProgramData/miniconda3/python.exe

# 工作空间 (默认 workspace/)
# WORKSPACE_DIR=D:/Users/viaco/PycharmProjects/ai_muice_steper/workspace
